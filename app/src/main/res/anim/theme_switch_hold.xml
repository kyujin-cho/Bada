<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Theme: keeps the old MainActivity on screen, unchanged, for as
     long as the new one fades in (theme_switch_fade_in), so the switch reads
     as a cross-fade in place. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="250"
    android:fromAlpha="1.0"
    android:toAlpha="1.0" />
