<?xml version="1.0" encoding="utf-8"?>
<!--
  Completed-state action row of the consent sheet, Bada theme: the original
  frosted button-shaped FrameLayouts (see activity_consent_trampoline.xml for
  why they are FrameLayouts). Inflated through the ViewStub
  consent_completed_actions_stub, which picks this layout or
  consent_completed_actions_m3e.xml from the badaConsentCompletedActionsLayout
  theme token. Both variants expose the same ids.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/consent_completed_close_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/badaFrostedButtonBackground"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="@string/consent_state_close"
            android:textAppearance="?attr/badaTextButton"
            android:textColor="?android:attr/textColorPrimary" />

    </FrameLayout>

    <Space
        android:id="@+id/consent_completed_button_gap"
        android:layout_width="12dp"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/consent_completed_view_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/badaFrostedButtonBackground"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="48dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="@string/consent_state_view_image"
            android:textAppearance="?attr/badaTextButton"
            android:textColor="?android:attr/textColorPrimary" />

    </FrameLayout>

</LinearLayout>
