<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings tab. Hosted by SettingsFragment inside MainActivity's
  bottom-navigation shell.

  Visual rhythm:
    Each setting group sits inside its own rounded white panel
    (`@drawable/settings_card_background`) with consistent inside
    padding, instead of sharing a single full-bleed LinearLayout.
    Pulls the page in line with the rest of the app, where the
    share flow uses a rounded MaterialCardView, the QR panel uses a
    chip-style URL field, and dialogs use rounded card surfaces —
    settings now reads as part of the same family rather than as a
    plain text page on white.

    Inside each panel:
      * Title (Subhead bold)
      * Subtitle (Small, secondary color)
      * Read-out chip — current persisted value rendered with the
        same `@drawable/qr_url_background` chip used by the QR panel
        so "current value" reads as a real field, not a footnote.
      * Action row — single full-width pill for one-button cards,
        or a two-equal-weight pill row mirroring the QR panel's
        Close + Copy link layout for cards with a primary +
        secondary action. The previous borderless secondary buttons
        were the only place in the app using that style; replacing
        them with a frosted pill keeps the button language uniform.

  Layout order (matches the previous fragment so user expectations
  about which control lives where are preserved):
    1. Save-location settings (#42).
    2. Advertised Quick Share name (#141).
       Theme picker (Settings > Theme) follows it.
    3. Background activity (#47 follow-up).
    4. Keep screen on during transfers (#219).
    5. Expert transfer details (#220).
    6. Shake-to-report bug toggle (#166).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="@dimen/settings_content_bottom_padding">

        <!-- ============ Master switch (#239) ============
             settings_master_row — 60dp pill that turns Bada's receive side on
             or off. Off stops the receiver foreground service so the device is
             no longer discoverable; on starts it again. The whole row toggles;
             the SwitchCompat is the visual state and the background swaps
             between the tinted ON and neutral OFF plates. Wired in SettingsFragment. -->
        <LinearLayout
            android:id="@+id/settings_master_row"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="16dp"
            android:background="?attr/badaMasterOffBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/settings_master_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_master_on"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/settings_master_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:clickable="false"
                android:focusable="false" />

        </LinearLayout>


        <!-- ============ Card 0: Name Card (tap-to-share contacts) ============
             settings_name_card_row — clickable card (title "Name Card" + subtitle
             + a "›" chevron) that opens NameCardSetupActivity, the My Name Card
             setup page. Wired in SettingsFragment.onViewCreated. -->
        <LinearLayout
            android:id="@+id/settings_name_card_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/badaCardBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_name_card_row_title"
                    android:textAppearance="?attr/badaTextSubhead"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/settings_name_card_row_subtitle"
                    android:textAppearance="?attr/badaTextSmall"
                    android:textColor="?android:attr/textColorSecondary" />

            </LinearLayout>

            <!-- settings_name_card_dot — 8dp red dot (same as the update badge) shown
                 when no Name Card is set up yet. Toggled in SettingsFragment by
                 NameCardProfileStore.isConfigured(). -->
            <View
                android:id="@+id/settings_name_card_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/update_badge_dot"
                android:visibility="gone" />

            <!-- chevron — ">" affordance signalling this row opens a sub-page -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="›"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="22sp"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <!-- ============ Card 1: Save location ============
             marginTop matches every other card's 12dp gap. It was absent
             while this was the FIRST card; the Name Card row (#251) now
             sits above, and without the margin the two cards render
             flush against each other. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/badaSettingsSectionGap"
            android:background="?attr/badaCardBackground"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/main_save_location_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_save_location_title"
                android:textAppearance="?attr/badaTextSubhead"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/main_save_location_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/main_save_location_subtitle"
                android:textAppearance="?attr/badaTextSmall"
                android:textColor="?android:attr/textColorSecondary" />

            <!--
              "Current: …" read-out as a chip. textIsSelectable lets
              the user copy the resolved folder name (handy for
              support reports) without scrambling for a Toast.
            -->
            <TextView
                android:id="@+id/main_save_location_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="?attr/badaFieldBackground"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:textAppearance="?attr/badaTextBody2"
                android:textColor="?android:attr/textColorPrimary"
                android:textIsSelectable="true"
                tools:text="Current: Downloads (default)" />

            <LinearLayout
                app:badaButtonGroup="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/main_save_location_pick"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/main_save_location_pick" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/main_save_location_clear"
                    style="?attr/badaSecondaryButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/main_save_location_clear" />

            </LinearLayout>

        </LinearLayout>

        <!--
          ============ Card 2: Advertised name ============

          Visible receiver-name override for Quick Share discovery.
          The underlying [AdvertisedDeviceNames] storage refreshes the
          active receiver session after save/reset, and the pre-merge
          debug-loop regression matrix covers custom-name discovery in
          both GMS-to-Bada and Bada-to-GMS directions.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/badaSettingsSectionGap"
            android:background="?attr/badaCardBackground"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/main_advertised_name_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_advertised_name_title"
                android:textAppearance="?attr/badaTextSubhead"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/main_advertised_name_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/main_advertised_name_subtitle"
                android:textAppearance="?attr/badaTextSmall"
                android:textColor="?android:attr/textColorSecondary" />

            <!--
              Currently-advertised name shown as a chip read-out
              above the editor so the user can see what peers are
              seeing right now without having to reason about the
              EditText's empty-vs-default state.
            -->
            <TextView
                android:id="@+id/main_advertised_name_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="?attr/badaFieldBackground"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:textAppearance="?attr/badaTextBody2"
                android:textColor="?android:attr/textColorPrimary"
                android:textIsSelectable="true"
                tools:text="Currently advertised: V2547A" />

            <!--
              EditText wrapped in a soft chip surface (12dp corners,
              light gray fill, hairline). Replaces the bare
              underline-style EditText that was the only flat-line
              control left in the app. `background=null` on the
              inner widget would still pick up the platform's default
              underline drawable on some OEM skins, so we override
              with the chip drawable + matching internal padding.
            -->
            <ViewStub
                android:id="@+id/main_advertised_name_input_stub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout="?attr/badaAdvertisedNameInputLayout" />

            <LinearLayout
                app:badaButtonGroup="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/main_advertised_name_save"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/main_advertised_name_save" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/main_advertised_name_reset"
                    style="?attr/badaSecondaryButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/main_advertised_name_reset" />

            </LinearLayout>

        </LinearLayout>

        <!-- ============ Card: Theme (app theme picker) ============
             One radio option per AppTheme, built by SettingsFragment.wireThemePicker
             from item_theme_option.xml so a new theme only needs an enum entry.
             Picking an option saves it and recreates MainActivity, which re-applies
             the theme (AppThemes.applyTo) and restores this tab. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/badaSettingsSectionGap"
            android:background="?attr/badaThemeSectionBackground"
            android:orientation="vertical"
            android:padding="?attr/badaThemeSectionPadding">

            <TextView
                android:id="@+id/settings_theme_title"
                android:paddingHorizontal="?attr/badaSectionHeaderInset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_theme_title"
                android:textAppearance="?attr/badaTextSubhead"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/settings_theme_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- Options of the selected theme (badaThemeExtrasLayout token):
                 nothing for the Bada theme, the wallpaper colors switch for
                 the Expressive theme. -->
            <ViewStub
                android:id="@+id/settings_theme_extras_stub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout="?attr/badaThemeExtrasLayout" />

        </LinearLayout>

        <!-- ============ Card 3: Battery / background activity ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/badaSettingsSectionGap"
            android:background="?attr/badaCardBackground"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/settings_battery_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_battery_title"
                android:textAppearance="?attr/badaTextSubhead"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/settings_battery_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/settings_battery_subtitle"
                android:textAppearance="?attr/badaTextSmall"
                android:textColor="?android:attr/textColorSecondary" />

            <TextView
                android:id="@+id/settings_battery_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="?attr/badaFieldBackground"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:textAppearance="?attr/badaTextBody2"
                android:textColor="?android:attr/textColorPrimary"
                android:textIsSelectable="true"
                tools:text="Currently: not exempt — receiving may stop in the background" />

            <Button
                android:id="@+id/settings_battery_open"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/settings_battery_open" />

        </LinearLayout>

        <!-- ============ Card: Full-screen transfer alerts (API 34+) ============
             Hidden by default; SettingsFragment makes it visible only on
             Android 14+, where USE_FULL_SCREEN_INTENT became a grantable
             special access. Lets the consent PIN prompt pop full-screen
             over other apps / the lock screen when a transfer arrives
             while Bada is in the background. -->
        <LinearLayout
            android:id="@+id/settings_fsi_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/badaSettingsSectionGap"
            android:background="?attr/badaCardBackground"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/settings_fsi_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_fsi_title"
                android:textAppearance="?attr/badaTextSubhead"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/settings_fsi_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/settings_fsi_subtitle"
                android:textAppearance="?attr/badaTextSmall"
                android:textColor="?android:attr/textColorSecondary" />

            <TextView
                android:id="@+id/settings_fsi_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="?attr/badaFieldBackground"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:textAppearance="?attr/badaTextBody2"
                android:textColor="?android:attr/textColorPrimary"
                android:textIsSelectable="true"
                tools:text="Currently: full-screen alerts not allowed" />

            <Button
                android:id="@+id/settings_fsi_open"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/settings_fsi_open" />

        </LinearLayout>

        <!-- Switch settings (keep screen on, expert details, shake-to-report,
             auto update check): Bada cards or the Expressive segmented list,
             picked by the badaSettingsSwitchGroupLayout theme token. -->
        <ViewStub
            android:id="@+id/settings_switch_group_stub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/badaSettingsSwitchGroupGap"
            android:layout="?attr/badaSettingsSwitchGroupLayout" />

    </LinearLayout>

</ScrollView>
