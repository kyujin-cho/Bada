<?xml version="1.0" encoding="utf-8"?>
<!--
  Switch settings of the Settings tab, Bada theme: the original four switch
  cards (keep screen on, expert transfer details, shake-to-report, automatic
  update check), unchanged, in a plain column. Inflated through the ViewStub
  settings_switch_group_stub (badaSettingsSwitchGroupLayout token);
  settings_switch_group_m3e.xml is the Expressive variant with the same ids.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ============ Card 4: Keep screen on during transfers ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="?attr/badaCardBackground"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/main_keep_screen_on_title"
                android:textAppearance="?attr/badaTextSubhead"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/main_keep_screen_on_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/main_keep_screen_on_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/main_keep_screen_on_subtitle"
            android:textAppearance="?attr/badaTextSmall"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>

    <!-- ============ Card 5: Expert transfer details ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="?attr/badaCardBackground"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/main_transfer_expert_title"
                android:textAppearance="?attr/badaTextSubhead"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/main_transfer_expert_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/main_transfer_expert_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/main_transfer_expert_subtitle"
            android:textAppearance="?attr/badaTextSmall"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>

    <!-- ============ Card 6: Shake-to-report bug ============ -->
    <!--
      Switch row: title and Switch share a horizontal row so
      the toggle's affordance reads against its label. Subtitle
      drops below as a single block so the wider explanation
      doesn't squeeze the switch column. Mirrors the standard
      Material settings-row pattern (title-left + control-right
      + supporting text below).
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="?attr/badaCardBackground"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/main_bug_report_title"
                android:textAppearance="?attr/badaTextSubhead"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/main_bug_report_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/main_bug_report_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/main_bug_report_subtitle"
            android:textAppearance="?attr/badaTextSmall"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>

    <!-- ============ Card 7: Automatic update check ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="?attr/badaCardBackground"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_auto_update_title"
                android:textAppearance="?attr/badaTextSubhead"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/settings_auto_update_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/settings_auto_update_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_auto_update_subtitle"
            android:textAppearance="?attr/badaTextSmall"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>

</LinearLayout>
