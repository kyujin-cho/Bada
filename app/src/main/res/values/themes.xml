        <item name="badaToolbarTitleTextAppearance">@style/TextAppearance.Bada.ToolbarTitle</item>

        <item name="badaTextDisplay1">@style/TextAppearance.AppCompat.Display1</item>
        <item name="badaTextHeadline">@style/TextAppearance.AppCompat.Headline</item>
        <item name="badaTextTitle">@style/TextAppearance.AppCompat.Title</item>
        <item name="badaTextSubhead">@style/TextAppearance.AppCompat.Subhead</item>
        <item name="badaTextMedium">@style/TextAppearance.AppCompat.Medium</item>
        <item name="badaTextBody2">@style/TextAppearance.AppCompat.Body2</item>
        <item name="badaTextBody1">@style/TextAppearance.AppCompat.Body1</item>
        <item name="badaTextSmall">@style/TextAppearance.AppCompat.Small</item>
        <item name="badaTextCaption">@style/TextAppearance.AppCompat.Caption</item>
        <item name="badaTextButton">@style/TextAppearance.Bada.Button</item>
        <item name="badaTextStatusTitle">@style/TextAppearance.Bada.StatusTitle</item>

        <item name="badaColorAccent">@color/brand_primary</item>
        <item name="badaColorOnAccent">@color/brand_on_primary</item>
        <item name="badaColorNavIndicator">@color/nav_active_indicator</item>
        <item name="badaColorFrostedFill">@color/frosted_button_fill</item>
        <item name="badaColorSurfaceCard">@color/surface_card</item>
