        <item name="badaButtonStyle">@style/Widget.Bada.Button</item>
        <item name="badaSecondaryButtonStyle">@style/Widget.Bada.Button</item>
        <item name="badaPrimaryButtonStyle">@style/Widget.Bada.Button</item>
        <item name="badaOutlineButtonStyle">@style/Widget.Bada.Button.Outline</item>
        <item name="badaBannerButtonStyle">@style/Widget.Bada.Button.BannerAction</item>
