    <!-- Window variants: same window setup as the Theme.Bada.* twins. -->
    <style name="Theme.Bada.Expressive.SendSheet">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.2</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimation.Bada.SendSheet.Fast</item>
    </style>

    <style name="Theme.Bada.Expressive.SendInApp">
        <item name="android:windowAnimationStyle">@style/WindowAnimation.Bada.SendInApp</item>
    </style>

    <style name="Theme.Bada.Expressive.ReceiveSheet">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.2</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimation.Bada.ReceiveSheet</item>
    </style>

    <style name="Theme.Bada.Expressive.NameCardTransfer">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!--
      Buttons. Every style keeps the M3 Expressive shape state list from its
      parent, so the round container squares off while pressed and when a
      checkable button is selected. maxLines=2 carries over the two-line
      label rule from Widget.Bada.Button (#307).
        * Default (plain <Button>, badaButtonStyle): tonal. Most Bada
          actions are neutral, so they sit one step back from the primary.
        * Filled: the one action a screen exists for (Send files, Accept).
        * Outlined: the send sheet's Cancel / Done plate over the blur.
    -->
    <style name="Widget.Bada.Expressive.Button" parent="Widget.Material3Expressive.Button.TonalButton">
        <item name="android:maxLines">2</item>
    </style>

    <!-- Same tonal button at the Medium size (56dp) for the free-standing
         actions that badaButtonStyle marks (home tab, send sheet). Plain
         buttons inside settings cards keep the default Small size. -->
    <style name="Widget.Bada.Expressive.Button.Prominent">
        <item name="materialSizeOverlay">@style/SizeOverlay.Material3Expressive.Button.Medium</item>
    </style>

    <style name="Widget.Bada.Expressive.Button.Filled" parent="Widget.Material3Expressive.Button">
        <item name="android:maxLines">2</item>
        <item name="materialSizeOverlay">@style/SizeOverlay.Material3Expressive.Button.Medium</item>
    </style>

    <style name="Widget.Bada.Expressive.Button.Outlined" parent="Widget.Material3Expressive.Button.OutlinedButton">
        <item name="android:maxLines">2</item>
        <item name="materialSizeOverlay">@style/SizeOverlay.Material3Expressive.Button.Medium</item>
    </style>

    <!-- Secondary action next to a tonal one inside a card (Reset): outlined
         at the card's Small size, one emphasis step below the tonal button. -->
    <style name="Widget.Bada.Expressive.Button.Outlined.Small">
        <item name="materialSizeOverlay">@style/SizeOverlay.Material3Expressive.Button.Small</item>
    </style>

    <!--
      Home-tab visibility toggle (#34) in the Expressive theme: a checkable
      filled-tonal button. Checked = always visible, painted with the
      primary role; unchecked uses the tonal container. The M3 Expressive
      shape state list squares the corners when checked, so turning the
      device visible is a shape morph, not just a color swap. This is one
      of the theme's two hero moments.
    -->
    <style name="Widget.Bada.Expressive.Button.VisibilityToggle" parent="Widget.Material3Expressive.Button">
        <item name="android:checkable">true</item>
        <item name="android:maxLines">2</item>
        <item name="materialSizeOverlay">@style/SizeOverlay.Material3Expressive.Button.Large</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.Bada.Expressive.VisibilityToggle</item>
    </style>

    <style name="ThemeOverlay.Bada.Expressive.VisibilityToggle" parent="">
        <item name="colorContainer">?attr/colorPrimary</item>
        <item name="colorContainerChecked">?attr/colorPrimary</item>
        <item name="colorContainerUnchecked">?attr/colorSecondaryContainer</item>
        <item name="colorOnContainer">?attr/colorOnPrimary</item>
        <item name="colorOnContainerChecked">?attr/colorOnPrimary</item>
        <item name="colorOnContainerUnchecked">?attr/colorOnSecondaryContainer</item>
    </style>

    <!--
      Fallback for ExpressiveMotion.spring() when a context's theme has no
      spring token: the M3 Expressive default spatial spring.
    -->
    <style name="Motion.Bada.Spring.Fallback" parent="">
        <item name="stiffness">380</item>
        <item name="damping">0.8</item>
    </style>

    <!--
      Expressive list item placed directly on the page. MDC's segmented item
      container is surface, the page color here, so items on the page use
      surface container instead (checked: secondary container, as in MDC).
      Items inside a card keep the MDC default (surface), which already sits
      two steps from the card's surface container.
    -->
    <style name="Widget.Bada.Expressive.ListItemCard.OnPage" parent="Widget.Material3.ListItemCardView.Segmented">
        <item name="cardBackgroundColor">@color/m3e_list_item_on_page</item>
    </style>

    <style name="Widget.Bada.Expressive.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/m3e_menu_background</item>
        <item name="android:popupElevation">3dp</item>
    </style>

    <!-- Toolbar overflow: opens below the trigger instead of over it. -->
    <style name="Widget.Bada.Expressive.PopupMenu.Overflow" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/m3e_menu_background</item>
        <item name="android:popupElevation">3dp</item>
        <item name="overlapAnchor">false</item>
    </style>

    <!-- Selectable item on the page (theme picker): position shapes only, so
         selecting or pressing changes the color, not the outline. -->
    <style name="Widget.Bada.Expressive.ListItemCard.OnPage.Selectable">
        <item name="shapeAppearance">@xml/m3e_list_item_shape_positions</item>
    </style>

    <!-- Popup menu list: rounded, inset item highlight (m3e_menu_item_selector)
         so a pressed item never reaches past the menu's rounded corners. -->
    <style name="Widget.Bada.Expressive.DropDownListView" parent="Widget.AppCompat.ListView.DropDown">
        <item name="android:listSelector">@drawable/m3e_menu_item_selector</item>
        <item name="android:drawSelectorOnTop">false</item>
        <item name="android:divider">@null</item>
    </style>

    <style name="Widget.Bada.Expressive.CircularProgressIndicator" parent="Widget.Material3Expressive.CircularProgressIndicator.Wavy" />

    <!--
      Navigation. The M3 Expressive bar draws the pill active indicator and
      the expressive label/icon tints; labels stay visible on both tabs as
      in the Bada theme. The landscape pill keeps its floating geometry
      (activity_main.xml land) on a fully rounded surface container.
    -->
    <style name="Widget.Bada.Expressive.BottomNav" parent="Widget.Material3Expressive.BottomNavigationView">
        <item name="labelVisibilityMode">labeled</item>
        <!-- M3 navigation bar accessibility: "Selected label is bold". -->
        <item name="itemTextAppearanceActiveBoldEnabled">true</item>
    </style>

    <style name="Widget.Bada.Expressive.NavPill" parent="Widget.Bada.Expressive.BottomNav">
        <item name="android:background">@drawable/m3e_nav_pill_background</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Toolbar and its overflow popup use the theme's own M3 ripple and
         menu styles; the Bada no-ripple overlay is Bada-specific. -->
    <style name="ThemeOverlay.Bada.Expressive.Toolbar" parent="" />

    <!-- PIN and other changing numerals: tabular figures, so digits keep
