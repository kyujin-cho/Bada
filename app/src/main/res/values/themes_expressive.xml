        <item name="android:textAppearanceSmall">@style/TextAppearance.Bada.Expressive.BodyMedium</item>

        <item name="viewInflaterClass">dev.bluehouse.bada.ui.theme.ExpressiveViewInflater</item>
        <item name="materialButtonStyle">@style/Widget.Bada.Expressive.Button</item>
        <!-- Cards: the M3 default is the outlined card, which drew a purple
             hairline around the send card. Bada's cards are fill-only, and so
